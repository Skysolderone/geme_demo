<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Siege.Godot</RootNamespace>
    <AssemblyName>Siege.Godot</AssemblyName>
    <!-- 本工程是全仓库唯一允许出现 Godot.* 的地方（.trellis/spec/core/boundaries.md）。引用方向单向：godot/ → Core / Presentation。 -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Siege.Core\Siege.Core.csproj" />
    <ProjectReference Include="..\Siege.Presentation\Siege.Presentation.csproj" />
  </ItemGroup>

</Project>
