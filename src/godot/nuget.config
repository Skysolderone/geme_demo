<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot 工程专用包源：追加 Godot 自带的本地 nupkgs 目录，离线或联网还原失败时兜底（tactical-ui 阶段 B）。
  路径写死在本机 Godot 安装位置。换机器时把下面这行改成该机的 GodotSharp/Tools/nupkgs，
  或直接删掉本文件——nuget.org 能连上时并不需要它。
-->
<configuration>
  <packageSources>
    <add key="godot-local" value="D:\software\godot\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
