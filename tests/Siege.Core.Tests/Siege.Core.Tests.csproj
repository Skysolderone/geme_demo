    <!-- ai-turn-speed 1.1：改动前钉入的固定种子 AI 决策序列基线（v5 到终局、board:1 限 12 大回合） -->
    <None Include="AiDecision\Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Siege.Core\Siege.Core.csproj" />
    <ProjectReference Include="..\..\src\Siege.Sim\Siege.Sim.csproj" />
    <ProjectReference Include="..\..\src\Siege.Presentation\Siege.Presentation.csproj" />
  </ItemGroup>

</Project>
